generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
}

model Order {
  id            String      @id @default(cuid())
  /// PayPal order id (unique business key for capture / webhook)
  paypalOrderId String      @unique
  productId     String
  productName   String
  amountCents   Int
  currency      String
  status        OrderStatus @default(PENDING)
  customId      String?
  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, createdAt])
}
