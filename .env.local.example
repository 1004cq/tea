# PayPal credentials — copy this file to .env.local and fill in values
# Get Client ID & Secret from https://developer.paypal.com/dashboard/applications

# Public Client ID (safe to expose in the browser)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
# Optional server-side alias (preferred on VPS EnvironmentFile)
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Secret (server-side only — never expose to the client)
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# sandbox | live
PAYPAL_MODE=sandbox
# Optional: used by Google Pay button environment selection in the browser
NEXT_PUBLIC_PAYPAL_MODE=sandbox

# Optional: default checkout currency (ISO 4217)
NEXT_PUBLIC_PAYPAL_CURRENCY=USD
PAYPAL_CURRENCY=USD

# Optional: webhook verification + event log path
# Webhook URL example: https://your-domain/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_LOG_FILE=

# Optional: where this shop records PayPal order ids it created.
# Capture rejects any order id that is not in this file. Default: data/paypal-orders.json
PAYPAL_ORDER_STORE_FILE=

# --- Alipay AI Pay (Vibe Pay / AI 网页应用收款) ---
# Sandbox credentials from open.alipay.com / aipay console. Never commit real keys.
AIPAY_APP_ID=
# Application public key (uploaded to Alipay; optional for Node SDK runtime)
AIPAY_PUBLIC_KEY=
# Prefer non-Java PKCS private key for Node; fall back to AIPAY_PRIVATE_KEY
AIPAY_PRIVATE_PKCS_KEY=
AIPAY_PRIVATE_KEY=
# Alipay platform public key (for notify / return signature verification)
AIPAY_ALIPAY_PUBLIC_KEY=
# Optional override. Default: PKCS1 when AIPAY_PRIVATE_PKCS_KEY is set, else PKCS8
AIPAY_KEY_TYPE=
# Sandbox gateway (default). Live: https://openapi.alipay.com/gateway.do
AIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# Public site origin used to build return/notify URLs
AIPAY_BASE_URL=https://shop.duojiayi.com
# Defaults: {AIPAY_BASE_URL}/aipay and {AIPAY_BASE_URL}/aipay/notify
AIPAY_RETURN_URL=
AIPAY_NOTIFY_URL=
AIPAY_EVENT_LOG_FILE=
# Set to false to hide the Alipay button in the browser
NEXT_PUBLIC_AIPAY_ENABLED=true
